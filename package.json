{
  "name": "baracksilasmungai",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio and website-development services site for Barack Silas Mungai",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "smtp:check": "node --env-file=.env -e \"require('nodemailer').createTransport({host:process.env.SMTP_HOST,port:+process.env.SMTP_PORT,secure:String(process.env.SMTP_SECURE)==='true',auth:{user:process.env.SMTP_USER,pass:process.env.SMTP_PASS}}).verify().then(()=>console.log('SMTP OK')).catch(e=>{console.error('SMTP FAILED:',e.message);process.exit(1)})\"",
    "tech:build": "node tools/gen-tech.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "simple-icons": "^16.33.0"
  }
}
